# OffsetProof local environment — copy to `.env`, never commit secrets.
# No cloud credentials are needed for Gates A–C. Gate D (optional LLM
# investigator) reads its key from LLM_API_KEY only.

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_IMAGE=apache/kafka:4.1.2
POSTGRES_IMAGE=postgres:16
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=offsetproof
POSTGRES_USER=offsetproof
POSTGRES_PASSWORD=offsetproof-local-only
ORDERS_TOPIC=orders.events
DLQ_TOPIC=orders.dlq
PROMETHEUS_PORT=8000
API_PORT=8080

# Gate D only. Absence must never break Gates A–C.
LLM_API_KEY=
LLM_MODEL=
